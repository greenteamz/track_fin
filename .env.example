# MFCentral credentials
MF_PAN=ABCDE1234F
MF_CAS_PASSWORD=your_password_here

# Path to downloaded CAS PDF
CAS_PDF_PATH=./cas-statement.pdf

# Stock tickers to track (comma-separated)
STOCK_TICKERS=OIL.NS,INDUSINDBK.NS

# Database path
DB_PATH=./portfolio.db

# Email config for automated CAS fetching (optional)
# For Gmail: use an App Password, not your regular password
# myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16char_app_password
